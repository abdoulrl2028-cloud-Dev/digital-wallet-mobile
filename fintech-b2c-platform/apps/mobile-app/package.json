{
  "name": "@carteira-digital/mobile-app",
  "version": "1.0.0",
  "description": "Aplicação mobile da carteira digital",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "xcodebuild -workspace ios/CarteiraMobile.xcworkspace -scheme CarteiraMobile -configuration Release"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-native": "^0.72.0",
    "@react-native-async-storage/async-storage": "^1.17.0",
    "@react-native-camera-roll/camera-roll": "^5.2.0",
    "@react-native-community/geolocation": "^3.2.1",
    "@react-native-masked-view/masked-view": "^0.2.8",
    "@react-navigation/bottom-tabs": "^6.4.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/stack": "^6.3.0",
    "react-native-gesture-handler": "^2.12.0",
    "react-native-reanimated": "^3.3.0",
    "react-native-safe-area-context": "^4.5.0",
    "react-native-screens": "^3.20.0",
    "react-native-vector-icons": "^9.2.0",
    "axios": "^1.4.0",
    "zustand": "^4.3.8",
    "jwt-decode": "^3.1.2",
    "crypto-js": "^4.1.0",
    "lodash": "^4.17.21",
    "@carteira-digital/shared-types": "*",
    "@carteira-digital/shared-utils": "*",
    "@carteira-digital/ui-design-system": "*"
  },
  "devDependencies": {
    "@react-native/cli": "^11.0.0",
    "@testing-library/react-native": "^12.0.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.40.0",
    "jest": "^29.5.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
